# Mutable entry points must be revalidated. Hash directories never change.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/playground.js
  Cache-Control: no-cache
/playground.css
  Cache-Control: no-cache
/editor.js
  Cache-Control: no-cache
/lessons.js
  Cache-Control: no-cache
/worker.js
  Cache-Control: no-cache
/runtime.js
  Cache-Control: no-cache
/pkg/manifest.json
  Cache-Control: no-cache
/pkg/:build/*
  Cache-Control: public, max-age=31536000, immutable
